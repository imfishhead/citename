{
  "manifest_version": 3,
  "name": "CiteName",
  "version": "1.3.1",
  "description": "下載學術 PDF 或碩博士論文網 ZIP 後，自動依作者、年份與標題重新命名。",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "notifications",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/citename-16.png",
    "32": "icons/citename-32.png",
    "48": "icons/citename-48.png",
    "128": "icons/citename-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://ndltd.ncl.edu.tw/cgi-bin/gs32/gsweb.cgi/*"],
      "js": ["ndltd.js", "ndltd-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CiteName",
    "default_icon": {
      "16": "icons/citename-16.png",
      "32": "icons/citename-32.png"
    },
    "default_popup": "popup.html"
  }
}
