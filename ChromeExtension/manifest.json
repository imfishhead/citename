{
  "manifest_version": 3,
  "name": "CiteName",
  "version": "2.0.14",
  "minimum_chrome_version": "116",
  "description": "下載學術 PDF、碩博士論文網 ZIP 或國圖期刊全文後，自動依作者、年份與標題重新命名。",
  "permissions": [
    "downloads",
    "notifications",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/citename-16.png",
    "32": "icons/citename-32.png",
    "48": "icons/citename-48.png",
    "128": "icons/citename-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["citation.js", "citation-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ndltd.ncl.edu.tw/cgi-bin/gs32/gsweb.cgi/*"],
      "js": ["ndltd.js", "ndltd-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://tpl.ncl.edu.tw/NclService/JournalContentDetail*"],
      "js": ["ndltd.js", "tpl.js", "tpl-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CiteName",
    "default_icon": {
      "16": "icons/citename-16.png",
      "32": "icons/citename-32.png"
    },
    "default_popup": "popup.html"
  }
}
